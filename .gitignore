# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── PyInstaller / Nuitka build artefacts ────────────────────────────────────
build/
server/build/
client/build/
server/dist/
client/dist/
dist/
*.spec.bak
nuitka-crash-report.xml

# ─── Release output (compiled EXEs, payload ZIPs) ────────────────────────────
release/

# ─── Android app build artifacts (buildozer cache + output APKs) ────────────
# These are symlinks to an out-of-repo build cache on this machine, not real
# directories, so trailing-slash patterns won't match them.
android/.buildozer
android/bin
android/.venv

# ─── Loose ZIP archives ───────────────────────────────────────────────────────
windows_scripts.zip
*.zip

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# ─── Local secrets (use *.example.ini as template) ───────────────────────────
server/server_config.ini
client/client_config.ini

# ─── Logs & temp ─────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
install_log_*.txt
